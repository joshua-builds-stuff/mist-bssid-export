# Mist BSSID Export configuration
# Copy this file to .env and fill in your values.
# Note: values are read up to an unquoted ' #', so inline comments are safe;
# quote a value if it must contain a literal '#'.
#
# Only the four keys below are loaded. Every other line is left unread,
# including HTTP_PROXY, HTTPS_PROXY, ALL_PROXY, NO_PROXY,
# REQUESTS_CA_BUNDLE, and CURL_CA_BUNDLE. API calls do not use those
# variables from .env or from the process environment (trust_env is off).
# TLS still uses the default requests CA bundle. Reach the Mist cloud
# directly; this tool has no proxy or custom-CA setting.

# Mist API token (create one at <cloud>/api/v1/self/apitokens or via the
# Mist portal: My Account > API Tokens). Read-only access is sufficient.
MIST_API_TOKEN=your-api-token-here

# Organization ID (Mist portal: Organization > Settings)
MIST_ORG_ID=your-org-id-here

# Cloud — uncomment and set exactly ONE of the following.
# (If both are set they must agree, otherwise the tool errors out.)
#
# Option A: https URL of one host below (host only — no user, port, path,
# or query). The session calls https:// plus that hostname.
#   Global 01: https://api.mist.com          EMEA 01: https://api.eu.mist.com
#   Global 02: https://api.gc1.mist.com      EMEA 02: https://api.gc3.mist.com
#   Global 03: https://api.ac2.mist.com      EMEA 03: https://api.ac6.mist.com
#   Global 04: https://api.gc2.mist.com      EMEA 04: https://api.gc6.mist.com
#   Global 05: https://api.gc4.mist.com      APAC 01: https://api.ac5.mist.com
#                                            APAC 02: https://api.gc5.mist.com
#                                            APAC 03: https://api.gc7.mist.com
#MIST_API_URL=https://api.mist.com

# Option B: cloud shorthand instead of the URL
# (global01-global05, emea01-emea04, apac01-apac03)
#MIST_CLOUD=global01
